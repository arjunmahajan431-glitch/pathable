# PathAble environment template.
#
# Copy to .env only if your shell/tool loads dotenv files. The app itself reads
# these from the process environment; `make dev` does not auto-load .env.
# NEVER commit .env, tokens, or credentials.

# Optional: enable admin review. Generate a long random value and keep it
# outside the repository. Without it, PATCH /api/reports/{id} returns 503.
PATHABLE_ADMIN_TOKEN=

# Optional: SQLite location. Default is config/areas.yaml -> reports.database.
# PATHABLE_DATABASE=data/cache/pathable.db

# Force the committed sample graph (1/true/yes). Leave unset for a live cache.
# PATHABLE_DEMO=0

# Comma-separated browser origins allowed by CORS. The defaults in
# config/areas.yaml are the two localhost:5173 forms; set this for deployment.
# PATHABLE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: use a GraphML file instead of the computed cache path.
# PATHABLE_GRAPH=/absolute/path/to/graph.graphml

# Optional: alternate YAML configuration file.
# PATHABLE_CONFIG=/absolute/path/to/areas.yaml
